{
  "manifest_version": 3,
  "name": "YouPoisk",
  "version": "0.5.3",
  "description": "Оценки, рецензии и «Посмотрю позже» YouTube в вашем аккаунте YouPoisk.",
  "permissions": [
    "activeTab",
    "alarms"
  ],
  "background": {
    "scripts": [
      "config.js",
      "core.js",
      "storage-idb.js",
      "storage-firefox.js",
      "auth-worker.js",
      "background-common.js",
      "background.firefox.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouPoisk",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "24": "assets/icons/icon-24.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "config.js",
        "core.js",
        "bridge.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youpoisk-dev@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent",
          "personalCommunications"
        ]
      }
    }
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png",
    "128": "assets/icons/icon-128.png"
  }
}
