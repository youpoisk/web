{
  "manifest_version": 3,
  "name": "YouPoisk",
  "version": "0.4.0",
  "description": "Оценка видео YouTube 1–10, «Посмотрю позже» и рецензии. Данные хранятся в этом браузере.",
  "permissions": [
    "activeTab"
  ],
  "background": {
    "scripts": [
      "config.js",
      "core.js",
      "storage-firefox.js",
      "background-common.js",
      "background.firefox.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouPoisk",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "24": "assets/icons/icon-24.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "config.js",
        "core.js",
        "bridge.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youpoisk-dev@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png",
    "128": "assets/icons/icon-128.png"
  }
}
