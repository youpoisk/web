{
  "name": "youpoisk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm api:check && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:extension": "node --test extension/tests/*.test.mjs",
    "api:import": "node scripts/contract.mjs import",
    "api:generate": "node scripts/contract.mjs generate",
    "api:check": "node scripts/contract.mjs check",
    "api:check-source": "node scripts/contract.mjs check-source"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
