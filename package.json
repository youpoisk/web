{
  "name": "youpoisk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm demo:check && pnpm api:check && pnpm typecheck:api && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:extension": "node --test extension/tests/*.test.mjs",
    "api:import": "node scripts/contract.mjs import",
    "api:generate": "node scripts/contract.mjs generate",
    "api:check": "node scripts/contract.mjs check && node scripts/validators.mjs check",
    "api:check-source": "node scripts/contract.mjs check-source",
    "api:validators": "node scripts/validators.mjs generate",
    "test:api": "node --disallow-code-generation-from-strings --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-include=src/shared/api/client.ts --test-coverage-include=src/shared/auth/flow.ts --test-coverage-include=src/shared/auth/exchange.ts --test-coverage-include=src/shared/auth/session.ts --test-coverage-include=src/shared/auth/runtime.ts --test tests/*.test.mjs",
    "typecheck:api": "tsc -p tsconfig.type-tests.json",
    "demo:generate": "node scripts/demo-catalog.mjs",
    "demo:check": "node scripts/demo-catalog.mjs --check"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}